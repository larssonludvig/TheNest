@page "/loadout"
@inject IJSRuntime jsRuntime
@inject NavigationManager navManager

<div class="page-content fade-in">
    <div class="items">
        <div class="item">
            <h1 class="itemHeader">Build</h1>
            <ImagePicker ImagePath=@($"images/builds/{loadout.Class}.jpg") Label=@loadout.Class Items=@availableClasses OnClick="ClassChanged" />
        </div>
        <div class="items">
            <div class="item">
                <h1 class="itemHeader">Specialization</h1>
                <ImagePicker ImagePath=@($"images/specializations/{loadout.Specialization}.png") Label=@loadout.Specialization Items=@availableSpecializations OnClick="SpecializationChanged" />
            </div>
            <div class="item">
                <h1 class="itemHeader">Weapon</h1>
                <ImagePicker ImagePath=@($"images/weapons/{loadout.Weapon}.png") Label=@loadout.Weapon Items=@availableWeapons OnClick="WeaponChanged" />
            </div>
        </div>
        <div class="items">
            <div class="item">
                <h1 class="itemHeader">Gadgets</h1>
                <div class="items">
                    <ImagePicker ImagePath=@($"images/gadgets/{loadout.Gadgets[0]}.png") Label=@loadout.Gadgets[0] Items=@availableGadgets OnClick="Gadget1Changed" />
                    <ImagePicker ImagePath=@($"images/gadgets/{loadout.Gadgets[1]}.png") Label=@loadout.Gadgets[1] Items=@availableGadgets OnClick="Gadget2Changed" />
                    <ImagePicker ImagePath=@($"images/gadgets/{loadout.Gadgets[2]}.png") Label=@loadout.Gadgets[2] Items=@availableGadgets OnClick="Gadget3Changed" />
                </div>
            </div>
        </div>
    </div>
    <div style="height:2rem;" />
    <button class="large-button" @onclick="Share">
        Share
        <i class="bi bi-link" style="color: white;" />
    </button>
    @if (copied)
    {
        <p>Copied to clipboard!</p>
    }
</div>

@code {
    public Loadout loadout = new Loadout();
    private List<string> availableClasses = new List<string>();
    private List<string> availableSpecializations = new List<string>();
    private List<string> availableWeapons = new List<string>();
    private List<string> availableGadgets = new List<string>();

    private ItemsByClass items = new ItemsByClass();

    private bool copied = false;

    protected override async Task OnInitializedAsync()
    {
        await items.Initialize();

        string uri = navManager.Uri;
        if (uri.Contains("class="))
            loadout.Class = uri.Split("class=")[1].Split("&")[0];
        if (uri.Contains("spec="))
            loadout.Specialization = uri.Split("spec=")[1].Split("&")[0];
        if (uri.Contains("weapon="))
            loadout.Weapon = uri.Split("weapon=")[1].Split("&")[0];
        if (uri.Contains("gadget1="))
            loadout.Gadgets.Add(uri.Split("gadget1=")[1].Split("&")[0]);
        if (uri.Contains("gadget2="))
            loadout.Gadgets.Add(uri.Split("gadget2=")[1].Split("&")[0]);
        if (uri.Contains("gadget3="))
            loadout.Gadgets.Add(uri.Split("gadget3=")[1]);

        while (loadout.Gadgets.Count < 3)
            loadout.Gadgets.Add("");

        availableClasses = items.Classes;
        availableSpecializations = items.LSpecializations.Union(items.MSpecializations).Union(items.HSpecializations).ToList();
        availableWeapons = items.LWeapons.Union(items.MWeapons).Union(items.HWeapons).ToList();
        availableGadgets = items.LGadgets.Union(items.MGadgets).Union(items.HGadgets).ToList();
    }

    private void ClassChanged(string str)
    {
        if (str == loadout.Class)
            return;

        loadout = new Loadout();
        // To fix nullpointer exception
        loadout.Gadgets = new List<string> { "", "", "" };


        loadout.Class = str;

        SetAvailableItems(str);
    }

    private void SpecializationChanged(string str)
    {
        if (loadout.Class != "Light" && items.LSpecializations.Contains(str))
            SetAvailableItems("Light");
        else if (loadout.Class != "Medium" && items.MSpecializations.Contains(str))
            SetAvailableItems("Medium");
        else if (loadout.Class != "Heavy" && items.HSpecializations.Contains(str))
            SetAvailableItems("Heavy");

        loadout.Specialization = str;
    }

    private void WeaponChanged(string str)
    {
        if (loadout.Class != "Light" && items.LWeapons.Contains(str))
            SetAvailableItems("Light");
        else if (loadout.Class != "Medium" && items.MWeapons.Contains(str))
            SetAvailableItems("Medium");
        else if (loadout.Class != "Heavy" && items.HWeapons.Contains(str))
            SetAvailableItems("Heavy");

        loadout.Weapon = str;
    }

    private void Gadget1Changed(string str)
    {
        if (!string.IsNullOrEmpty(loadout.Gadgets[0]) && !availableGadgets.Contains(loadout.Gadgets[0]))
            availableGadgets.Add(loadout.Gadgets[0]);

        loadout.Gadgets[0] = str;
        availableGadgets.Remove(str);
    }

    private void Gadget2Changed(string str)
    {
        if (!string.IsNullOrEmpty(loadout.Gadgets[1]) && !availableGadgets.Contains(loadout.Gadgets[1]))
            availableGadgets.Add(loadout.Gadgets[1]);

        loadout.Gadgets[1] = str;
        availableGadgets.Remove(str);
    }

    private void Gadget3Changed(string str)
    {
        if (!string.IsNullOrEmpty(loadout.Gadgets[2]) && !availableGadgets.Contains(loadout.Gadgets[2]))
            availableGadgets.Add(loadout.Gadgets[2]);

        loadout.Gadgets[2] = str;
        availableGadgets.Remove(str);
    }

    private void SetAvailableItems(string c)
    {
        loadout.Class = c;

        loadout.Gadgets = new List<string> { "", "", "" };

        switch (c)
        {
            case "Light":
                availableSpecializations = items.LSpecializations;
                availableWeapons = items.LWeapons;
                availableGadgets = items.LGadgets;
                break;
            case "Medium":
                availableSpecializations = items.MSpecializations;
                availableWeapons = items.MWeapons;
                availableGadgets = items.MGadgets;
                break;
            case "Heavy":
                availableSpecializations = items.HSpecializations;
                availableWeapons = items.HWeapons;
                availableGadgets = items.HGadgets;
                break;
        }
    }

    private void Share()
    {
        string baseUri;
        if (navManager.Uri.Contains("?"))
            baseUri = navManager.Uri.Split("?")[0];
        else
            baseUri = navManager.Uri;

        string url = $"{baseUri}?class={loadout.Class}&spec={loadout.Specialization}&weapon={loadout.Weapon}&gadget1={loadout.Gadgets[0]}&gadget2={loadout.Gadgets[1]}&gadget3={loadout.Gadgets[2]}";
        jsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        copied = true;
    }
}