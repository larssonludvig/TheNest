@page "/notes"
@inject ApiService ApiService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@using Domain
@using BlazorPanzoom
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Globalization

<div class="page-content fade-in">
    <div class="content-header">
        <h1 class="m-0">Notes</h1>
        <p style="opacity: 0.8;">If you do not know what this is, then you do not belong here.</p>
    </div>
    <div class="content-area p-2">
        <h3>Auth Token</h3>
        <input type="password" placeholder="token..." @bind="token" />
        <button @onclick="SubmitToken">Submit</button>
        <div class="separator mt-2 mb-2" />
        <h3>New Note</h3>
        @if (ploppIsLive) 
        {
            <textarea placeholder="note..." rows="4" cols="50" @bind="@textNote" />
            <div style="display: flex; gap: 1rem; align-items: center;">
                <button class="large-button p-2" style="font-size: medium;" @onclick="CreateNote">Create Note</button>
                @if (creating)
                {
                    <Spinner Color="SpinnerColor.Primary" />
                }
            </div>
        }
        else
        {
            <p style="opacity: 0.8;">Plopparn is not live, notes cannot be created.</p>
        }
        <div class="separator mt-2 mb-2" />
        <div style="display: flex; gap: 1rem; align-items: center;">
            <h3>Saved Notes</h3>
            <i class="bi bi-arrow-clockwise h4" style="color: #DBDBDB;" @onclick=@(async () => { await FetchData(); }) />
        </div>
        <div class="p-2" style="display: flex; width: 100%; padding-right: 16px;">
            <span class="searchbar">
                <input class="searchbarinput" type="text" @bind="searchString" @oninput="@(e => { searchString = e.Value?.ToString() ?? ""; })" @onkeydown="@OnInput" placeholder="Search by note" />
                <button @onclick="@(e => FetchData(searchString))">
                    <i class="bi bi-search" style="color: white;" />
                </button>
            </span>
            <p style="margin-left: 2rem; margin-right: 1rem;">Include used:</p>
            <Switch @bind-value="includeUsedPosts" @onclick=@(async () => { includeUsedPosts = !includeUsedPosts; await FetchData(searchString); }) />
        </div>
        <div class="grid">
            @if (!loading)
            {
                <QuickGrid Items="@notes" Pagination="@pagination">
                    <PropertyColumn Title="ID" Property="@(x => x.Id)" Sortable="true" InitialSortDirection="Microsoft.AspNetCore.Components.QuickGrid.SortDirection.Descending" IsDefaultSortColumn="true" Align="Align.Center" />
                    <PropertyColumn Title="Note" Property="@(x => x.Description)" />
                    <PropertyColumn Title="Username" Property="@(x => x.Username)" />
                    <TemplateColumn Title="VOD" class="text-center">
                        @{
                            string link = $"https://twitch.tv/videos/{context.StreamId}?t={context.ElapsedTime}";
                            <a href=@link><i class="bi bi-twitch" style="color: #DBDBDB; font-size: 1.5rem;" /></a>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Clip" class="text-center">
                        @if(!string.IsNullOrEmpty(context.ClipURI))
                        {
                            <a href=@context.ClipURI><i class="bi bi-link-45deg" style="color: #DBDBDB; font-size: 1.5rem;" /></a>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Used" class="text-center">
                        <button class="btn btn-link border-white" style="padding: 0 6px;" @onclick=@(async () => { await ToggleUsed(context.Id); })>
                            <i class="bi bi-check-lg" style="color: @(context.Used ? "#DBDBDB" : "#2B2B2B"); font-size: 1.5rem;" />
                        </button>
                    </TemplateColumn>
                    <TemplateColumn Title="Processed" class="text-center">
                        <button class="btn btn-link border-white" style="padding: 0 6px;" @onclick=@(async () => { await ToggleProcessed(context.Id); })>
                            <i class="bi bi-check-lg" style="color: @(context.Processed ? "#DBDBDB" : "#2B2B2B"); font-size: 1.5rem;" />
                        </button>
                    </TemplateColumn>
                    <TemplateColumn Title="Delete" class="text-center">
                        <button class="btn btn-link" @onclick=@(async () => { await ShowConfirmationModal(context.Id); })>
                            <i class="bi bi-trash" style="color: #DBDBDB; font-size: 1.5rem;" />
                        </button>
                    </TemplateColumn>
                </QuickGrid>
                <Paginator State=pagination />
            }
            else
            {
                <span style="display: flex; align-items: center; justify-content: center; height: 100%; margin: 5rem;">
                    <Spinner Color="SpinnerColor.Primary" />
                </span>
            }
        </div>
    </div>
</div>

<Modal @ref="confirmModal" Title="Confirm Deletion" class="confirmation-modal">
    <BodyTemplate>
        Are you sure you want to delete note: @noteToDeleteId?
    </BodyTemplate>
    <FooterTemplate>
        <button @onclick="@(async () => { await ToggleDeleted(noteToDeleteId); })">Confirm</button>
        <button @onclick="HideConfirmationModal">Cancel</button>
    </FooterTemplate>
</Modal>

@code {
    private int offset = 1;
    private IQueryable<Note>? notes = null;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    private bool loading = false;
    private bool creating = false;
    private string token = "";
    private string textNote = "";
    private string searchString = "";

    private bool includeUsedPosts = false;

    private Modal confirmModal;
    private int noteToDeleteId = -1;

    private bool ploppIsLive = false;

    protected override async Task OnInitializedAsync()
    {
        token = await localStorage.GetItemAsync<string>("notesAuth") ?? "";
        notes = default;
        await GetLiveStatus();
        await FetchData();
    }

    private async Task FetchData(string search = "")
    {
        loading = true;
        notes = null;
        StateHasChanged();

        Dictionary<string, string> headers = new Dictionary<string, string> {
            { "Authorization", token}
        };

        List<Note> res = await ApiService.Get<List<Note>>("notes/", headers);
        UpdateNotes(res);

        loading = false;
        StateHasChanged();
    }

    private async Task CreateNote() {
        creating = true;
        StateHasChanged();

        Note newNote = new Note
        {
            Description = textNote,
            Offset = offset
        };

        Dictionary<string, string> headers = new Dictionary<string, string> {
            { "Authorization", token}
        };

        List<Note> res = await ApiService.Put<List<Note>, Note>("notes", newNote, headers);
        notes = res.AsQueryable();

        textNote = "";
        creating = false;
        StateHasChanged();
    }

    private async Task OnInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await FetchData(searchString);
        }
    }

    private async Task SubmitToken()
    {
        await localStorage.SetItemAsync("notesAuth", token);
        await FetchData();
    }

    private async Task ToggleUsed(int id)
    {
        loading = true;
        StateHasChanged();

        Dictionary<string, string> headers = new Dictionary<string, string> {
            { "Authorization", token}
        };

        await ApiService.Post<List<Note>, int>($"notes/{id}/used", 1, headers);
        await FetchData(searchString);

        loading = false;
        StateHasChanged();
    }

    private async Task ToggleProcessed(int id)
    {
        loading = true;
        StateHasChanged();

        Dictionary<string, string> headers = new Dictionary<string, string> {
            { "Authorization", token}
        };

        await ApiService.Post<List<Note>, int>($"notes/{id}/processed", 1, headers);
        await FetchData(searchString);

        loading = false;
        StateHasChanged();
    }

    private async Task ShowConfirmationModal(int id)
    {
        noteToDeleteId = id;
        await confirmModal.ShowAsync();
    }

    private async Task HideConfirmationModal()
    {
        noteToDeleteId = -1;
        await confirmModal.HideAsync();
    }

    private async Task ToggleDeleted(int id)
    {
        loading = true;
        StateHasChanged();

        Dictionary<string, string> headers = new Dictionary<string, string> {
            { "Authorization", token}
        };

        await ApiService.Post<List<Note>, int>($"notes/{id}/delete", 1, headers);
        await FetchData(searchString);

        await HideConfirmationModal();

        loading = false;
        StateHasChanged();
    }

    private void UpdateNotes(List<Note> res)
    {
        if (!includeUsedPosts)
        {
            res = res.Where(x => !x.Used).ToList();
        }
        notes = res.AsQueryable();
    }

    private async Task<bool> GetLiveStatus()
    {
        ploppIsLive = await ApiService.Get<bool>("twitch/live", null);

        return ploppIsLive;
    }
}
