@page "/challenges"
@inject ApiService ApiService
@inject NavigationManager _nav
@using Domain

<div class="page-content fade-in">
    <div class="content-header" style="display: flex;">
        <h1 class="m-0">Challenges</h1>
    </div>
    <div class="content-area p-0" style="display: flex;">
        <div class="p-2" style="width: 100%;">
            <h3>SirYellowJacket's Ironman Challenge</h3>
            <p>For a specific build, get 5 kills with EVERY weapon. But if you die 3 times on one of the weapons, you have to start all over.</p>
            <iframe width="560" height="315" src="https://www.youtube.com/embed/G285JdU8EYA?si=O7mjGtseQAL1mM-U" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <div class="separator my-2"/>
            <h3>The Pacifist Challenge</h3>
            <p>Win a tournament of World Tour without dealing a single point of damage.</p>
            <iframe width="560" height="315" src="https://www.youtube.com/embed/KceVOobY2G4?si=f-QkJTpkaWu9nfzX" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <div class="separator my-2"/>
            <h3>Random Loadout</h3>
            <p>Randomize your loadout and play with what fate decides! Tool that can be used for randomization is available <a style="color: #DBDBDB;" href="/randomizer">Here!</a></p>
        </div>
    </div>
</div>

