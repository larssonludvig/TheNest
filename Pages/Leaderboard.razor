@page "/leaderboard"
@inject ApiService ApiService
@inject NavigationManager _nav
@using Domain
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Globalization

<div class="page-content fade-in">
    <div class="content-header">
        <h1 class="m-0">Leaderboards</h1>
    </div>

    <div class="content-area">
        <p class="px-3 pt-2">This site uses a public API wrapper that can be found <a style="color: white;" href="https://github.com/leonlarsson/the-finals-api">Here!</a></p>
        <div style="display: flex; gap: 8px; flex-direction: row; margin: 1rem; flex-wrap: wrap;">
@* Search bar *@
            <span class="searchbar">
                <input class="searchbarinput" type="text" @bind="searchString" @oninput="@(e => { searchString = e.Value?.ToString() ?? ""; })" @onkeydown="@OnInput" placeholder="Search by name" />
                <button @onclick="@(e => FetchData(searchString))">
                    <i class="bi bi-search" style="color: white;" />
                </button>
            </span>

@* Season radio buttons *@
            <div class="radio-group">
                <div class="radio-button" @onclick="@(() => SetSeason("s9"))">
                    <input type="radio" name="s9" checked="@(season == "s9")" />
                    <label for="s9">Ranked</label>
                </div>
                <div class="radio-button" @onclick="@(() => SetSeason("s9worldtour"))">
                    <input type="radio" name="s9worldtour" checked="@(season == "s9worldtour")" />
                    <label for="s9worldtour">World Tour</label>
                </div>
                <div class="radio-button" @onclick="@(() => SetSeason("s9sponsor"))">
                    <input type="radio" name="s9sponsor" checked="@(season == "s9sponsor")" />
                    <label for="s9sponsor">Sponsor</label>
                </div>
            </div>

            <Dropdown>
                <DropdownToggleButton>Old Leaderboards</DropdownToggleButton>
                <DropdownMenu>
                    <DropdownItem @onclick="@(() => SetSeason("s8"))">Season 8 Ranked</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s8worldtour"))">Season 8 World Tour</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s8sponsor"))">Season 8 Sponsor</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s7"))">Season 7 Ranked</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s7worldtour"))">Season 7 World Tour</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s7sponsor"))">Season 7 Sponsor</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s6"))">Season 6 Ranked</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s6worldtour"))">Season 6 World Tour</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s6sponsor"))">Season 6 Sponsor</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s5"))">Season 5 Ranked</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s5worldtour"))">Season 5 World Tour</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s5sponsor"))">Season 5 Sponsor</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s4"))">Season 4 Ranked</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s4worldtour"))">Season 4 World Tour</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s4sponsor"))">Season 4 Sponsor</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s3"))">Season 3 Ranked</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s3worldtour"))">Season 3 World Tour</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s2"))">Season 2</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("s1"))">Season 1</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("ob"))">Open Beta</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("cb2"))">Closed Beta 2</DropdownItem>
                    <DropdownItem @onclick="@(() => SetSeason("cb1"))">Closed Beta 1</DropdownItem>
                </DropdownMenu>
            </Dropdown>

            @if (season == "s2" || season == "s1" || season == "ob")
            {
                <div class="radio-group" style="margin-bottom: 0;">
                    <div class="radio-button" @onclick="@(() => SetPlatform("crossplay"))">
                        <input type="radio" name="crossplay" checked="@(platform == "crossplay")" />
                        <label for="crossplay">
                            <i class="bi bi-globe2" style="color: #DBDBDB" />
                        </label>
                    </div>
                    <div class="radio-button" @onclick="@(() => SetPlatform("steam"))">
                        <input type="radio" name="steam" checked="@(platform == "steam")" />
                        <label for="steam">
                            <i class="bi bi-steam" style="color: #DBDBDB" />
                        </label>
                    </div>
                    <div class="radio-button" @onclick="@(() => SetPlatform("xbox"))">
                        <input type="radio" name="xbox" checked="@(platform == "xbox")" />
                        <label for="xbox">
                            <i class="bi bi-xbox" style="color: #DBDBDB" />
                        </label>
                    </div>
                    <div class="radio-button" @onclick="@(() => SetPlatform("psn"))">
                        <input type="radio" name="psn" checked="@(platform == "psn")" />
                        <label for="psn">
                            <i class="bi bi-playstation" style="color: #DBDBDB" />
                        </label>
                    </div>
                </div>
            }
        </div>

@* Leaderboard grid *@
        @if (!loading)
        {
            <div class="grid">
                <QuickGrid Items="@data" Pagination=@pagination>
                    <PropertyColumn Property="@(x => x.Rank)" Sortable="true" InitialSortDirection="Microsoft.AspNetCore.Components.QuickGrid.SortDirection.Ascending" IsDefaultSortColumn="true" Align="Align.Center" />
                    <TemplateColumn Title="Name">
                        <span>
                            <p class="m-0" style="color: #DBDBDB;">@context.Name</p>
                            @if (!string.IsNullOrEmpty(context.SteamName))
                            {
                                <span style="display: flex; align-items: center;">
                                    <i class="bi bi-steam" style="color: #DBDBDB;" />
                                    <p class="m-0" style="padding-left: 5px;">@context.SteamName</p>
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(context.PsnName))
                            {
                                <span style="display: flex; align-items: center;">
                                    <i class="bi bi-playstation" style="color: #DBDBDB;" />
                                    <p class="m-0" style="padding-left: 5px;">@context.PsnName</p>
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(context.XboxName))
                            {
                                <span style="display: flex; align-items: center;">
                                    <i class="bi bi-xbox" style="color: #DBDBDB;" />
                                    <p class="m-0" style="padding-left: 5px;">@context.XboxName</p>
                                </span>
                            }
                        </span>
                    </TemplateColumn>
                    @if (season.Contains("worldtour"))
                    {
                        <TemplateColumn Title="Cashouts">
                            <p>@string.Format(new CultureInfo("en-us"), "{0:c}", context.Cashouts).Replace(".00", "")</p>
                        </TemplateColumn>
                    }
                    else if (season.Contains("sponsor"))
                    {
                        <TemplateColumn Title="Sponsor">
                            <p>@context.Sponsor</p>
                        </TemplateColumn>
                        <TemplateColumn Title="Fans">
                            <p>@string.Format(new CultureInfo("en-us"), "{0:c}", context.Fans).Replace(".00", "").Replace("$", "")</p>
                        </TemplateColumn>
                    }
                    else 
                    {
                        <TemplateColumn Title="24h Change" Align="Align.Center">
                            <span style="display: flex; align-items: center; justify-content: center;">
                                @if (context.Change > 0)
                                {
                                    <i class="bi bi-chevron-up" style="color: green;" />
                                    <p class="m-0" style="padding-left: 5px; color: green;">@context.Change</p>
                                }
                                @if (context.Change < 0)
                                {
                                    <i class="bi bi-chevron-down" style="color: red;" />
                                    <p class="m-0" style="padding-left: 5px; color: red;">@context.Change.ToString().Replace("-", "")</p>
                                }
                                @if (context.Change == 0)
                                {
                                    <i class="bi bi-dash" style="color: #DBDBDB;" />
                                    <p class="m-0" style="padding-left: 5px;">@context.Change</p>
                                }
                            </span>
                        </TemplateColumn>
                        <TemplateColumn Title="League">
                            <div style="display: flex;">
                                <img style="width: 3rem;" src="images/ranks/@(context.League.Replace(" ", "_")).png" /> 
                                <span style="margin-left: 5px; display: flex; flex-direction: column; justify-content: center;">
                                    <p class="m-0">@context.League</p>
                                    @if (context.RankScore > 0)
                                    {
                                        <p class="m-0">@string.Format(new CultureInfo("en-us"), "{0:c}", context.RankScore).Replace(".00", "").Replace("$", "")</p>
                                    }
                                </Span>               
                            </div>
                        </TemplateColumn>
                        @* <TemplateColumn>
                            <div style="display: flex; margin-right: 1rem;" onclick=@(() => {_nav.NavigateTo($"/users/{context.Name.Replace("#", "%23")}");})>
                                <i class="bi bi-graph-up h2" style="margin: 0 !important; color: #DBDBDB;"/>
                            </div>
                        </TemplateColumn> *@
                    }
                </QuickGrid>
            </div>
        }
        else
        {
@* Loading icon *@
            <span style="display: flex; align-items: center; justify-content: center; height: 100%; margin: 5rem;">
                <Spinner Color="SpinnerColor.Primary" />
            </span>
        }
        @if (!loading)
        {
            <Paginator State=pagination />
            <Dropdown class="pagination-group">
                <DropdownToggleButton>@pagination.ItemsPerPage</DropdownToggleButton>
                <DropdownMenu>
                    <DropdownItem @onclick="@(() => pagination.ItemsPerPage = 10)">10</DropdownItem>
                    <DropdownItem @onclick="@(() => pagination.ItemsPerPage = 25)">25</DropdownItem>
                    <DropdownItem @onclick="@(() => pagination.ItemsPerPage = 50)">50</DropdownItem>
                    <DropdownItem @onclick="@(() => pagination.ItemsPerPage = 100)">100</DropdownItem>
                </DropdownMenu>
            </Dropdown>
        }
    </div>
</div>


@code {
    [Parameter, SupplyParameterFromQuery]
    public string season { get; set; } = "s9";

    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private IQueryable<Data>? data = null;

    private string searchString = "";
    private string platform = "crossplay";
    private bool loading = false;

    protected override async Task OnInitializedAsync()
    {
        data = default;
        Console.WriteLine(season);
        await FetchData();
    }

    private async Task FetchData(string name = "")
    {
        loading = true;
        data = null;
        StateHasChanged();

        if (string.IsNullOrEmpty(season))
            season = "s9";

        string baseUrl = "https://api.the-finals-leaderboard.com/";
        string endpoint = "";
        if (season.Contains("cb"))
            endpoint = "v1/leaderboard/" + season;
        else
            endpoint = "v1/leaderboard/" + season + "/" + platform;

        if (!string.IsNullOrEmpty(name))
            endpoint = endpoint + "?name=" + name;

        Root root = await ApiService.Get<Root>(endpoint, baseUrl);
        data = root.Data.AsQueryable();
        loading = false;
        StateHasChanged();
    }

    private async Task OnInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await FetchData(searchString);
        }
    }

    private async Task SetSeason(string season)
    {
        _nav.NavigateTo("/leaderboard?season=" + season);
        this.season = season;
        if (!(season == "s2" || season == "s1" || season == "ob"))
            this.platform = "crossplay";

        await FetchData(searchString);
    }

    private async Task SetPlatform(string platform)
    {
        if (season == "s2" || season == "s1" || season == "ob")
            this.platform = platform;
        else 
            this.platform = "crossplay";
        
        await FetchData(searchString);
    }
}