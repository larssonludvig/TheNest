@page "/"
@inject ApiService ApiService
@inject NavigationManager _nav
@using Domain

<div class="page-content fade-in">
    <div class="content-header" style="display: flex;">
        <h1 class="m-0">Home</h1>
    </div>
    <div class="content-area p-0" style="display: flex;">
        <div class="p-2" style="width: 100%;">
            @if (ploppIsLive)
            {
                <h3 style="width: 100%;">Plopparn is live!</h3>
                <div style="aspect-ratio: 16/9; max-width: 1000px; display: flex;">
                    <iframe src="https://player.twitch.tv/?channel=plopparntv&parent=plopparn.tv&autoplay=true&muted=true&time=0s" width="100%" height="100%" frameborder="0" allowfullscreen style="" />
                    <iframe class="twitch-chat" src="https://www.twitch.tv/embed/plopparntv/chat?parent=plopparn.tv&darkpopout" height="100%"/>
                </div>
                <div class="separator mt-2 mb-2" />
            }

            <h2 style="width: 100%;">Hello There!</h2>
            <p style="width: 100%;">This little site have been brought to you by Tanamo. I want to start by thanking <a href="https://www.embark-studios.com/" style="color:white;">Embark Studios</a> for and amazing game and my dear friend <a href="https://www.twitch.tv/plopparntv" style="color:white;"><img src="images/twitch.png" alt="" style="width:1.5rem;" />PlopparnTV</a> for the idea for the site. </p>
            <br />
            <p style="width: 100%;">As of now, the site is still in development and I'm working on adding more features and improvements. If you have any suggestions or feedback, feel free to contact "tanamo" on Discord.</p>
            <br />
            <p style="width: 100%;">Thank you for visiting and I hope that you find some usage of the features of the site.</p>
            <br />
            <div style="width:100%;display:flex;justify-content:end;">
                <a style="color:white;text-decoration:none;" href="https://www.youtube.com/watch?v=G6k2A9SaFzE">*Insert chaotic cashout music*</a>
            </div>
            <div class="separator my-2"/>
            <h3 style="width: 100%;">Data Privacy</h3>
            <p style="width: 100%;">All your data is saved locally in your browser. Nothing is uploaded or shared.</p>
        </div>
    </div>
</div>

@code {
    private bool ploppIsLive = false;

    protected override async Task OnInitializedAsync()
    {
        await GetLiveStatus();
    }

    private async Task<bool> GetLiveStatus()
    {
        ploppIsLive = await ApiService.Get<bool>("twitch/live", null);

        return ploppIsLive;
    }
    
}
