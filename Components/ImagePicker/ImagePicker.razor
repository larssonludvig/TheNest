@namespace Components

<div class="image-area" @onclick="() => expanded = !expanded" style=@(IsDisabled?"":"cursor:pointer;")>
    <div class="image-layer1">
        <img class="image" src=@ImagePath alt=@Label onerror="this.src='images/404.png'" />
        <i class="bi bi-caret-down-fill image-drop"></i>
    </div>
    <p class="image-label">@Label.Replace("_", " ")</p>

    @if (expanded)
    {
        <div class="shadow fade-in" />
        <div class="items fade-in items-picker">
            @foreach (var item in Items)
            {
                <div class="item" @onclick="() => Clicked(item)">
                    <div class="image-area">
                        <div class="image-layer1">
                            @{
                                int lastSlashIndex = ImagePath.LastIndexOf('/')+1;
                                string basePath = ImagePath.Substring(0, lastSlashIndex);
                                string fileType = ImagePath.Contains("builds") ? ".jpg" : ".png";
                                <img class="image" src=@($"{basePath}{item}{fileType}") alt=item onerror="this.src='images/404.png'" />
                            }
                        </div>
                        <p class="image-label">@item.Replace("_", " ")</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public List<string> Items { get; set; } = new List<string>();
    [Parameter] public EventCallback<string> OnClick { get; set; }
    [Parameter] public string ImagePath { get; set; } = "images/404.png";
    [Parameter] public string Label { get; set; } = "";

    private bool expanded = false;

    private void Clicked(string item)
    {
        if (OnClick.HasDelegate)
            OnClick.InvokeAsync(item);
    }
}