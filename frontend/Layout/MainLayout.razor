@inherits LayoutComponentBase
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@using System.Reflection

<div class="page">
    @if (menuOpen)
    {
        <NavMenu OnToggleMenu="ToggleMenu" />
    }

    <main>
        @if (!menuOpen)
        {
            <article class="content px-4">
                @* Info bar *@
                <div style="width: 100vw; height: 2rem; background-color: rgb(228, 228, 39); color: black; display: flex; justify-content: center; align-items: center;">
                    <p style="padding: 0; margin: 0;">The site is under development, Leaderboards may not be working properly.</p>
                </div>
                @* Info bar *@
                @Body
            </article>
        }

        <div class="top-row px-4">
            <h1 class="m-0">THE NEST</h1>
            <p class="version-text">@version</p>
            <button class="btn btn-menu" style="margin-left:auto;" @onclick="ToggleMenu">
                <img src="images/menu.svg" alt="Menu" />
            </button>
        </div>
    </main>
</div>

@code {
    private string version = ""; 
    private bool menuOpen = false;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) {
            version = GetVersion();
            StateHasChanged();
        }
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
        StateHasChanged();
    }

    private string GetVersion()
    {
        var assembly = Assembly.GetExecutingAssembly();
        version = "v" + assembly?.GetName()?.Version?.ToString().Substring(0, 5);
        return version;
    }
}