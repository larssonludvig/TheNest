@page "/randomizer"
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject Constants Constants
@inject ApiService ApiService
@inject NavigationManager _nav
@inject IJSRuntime jsRuntime

<div class="fade-in" style='position: absolute; top: 0; left: 0; height: 100vh; width: 100vw; background-image: url("images/thefinalsbackground.png"); background-position: center; background-repeat: no-repeat; background-size: cover;' />

<div class="page-content fade-in">
    @if (loadout != null)
    {
        @* Play audio *@
        @if (!mute)
        {
            <audio autoplay><source src="audio/roll.mp3" /></audio>
        }

        @*  *@
        <div class="items fade-in" style="gap:2rem;">
            <div class="item">
                <h1 class="itemHeader">Build</h1>

                <div style="max-height: 10.5rem; overflow: hidden; margin-bottom: 2rem;">
                    @if (headers != null && loadout != null)
                    {
                        <div class="reel scroll-in">
                            <ImageCheckbox ImagePath="@($"images/builds/{loadout.Class}.jpg")" AltText="@(loadout.Class.Replace("_", " "))" IsDisabled="true" />
                            @{
                                foreach (var item in Constants.Classes)
                                {
                                    <ImageCheckbox ImagePath="@($"images/builds/{item}.jpg")" AltText="@(item.Replace("_", " "))" IsDisabled="true" />
                                }
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="items">
                @if (rollSpecialization)
                {
                    <div class="item">
                        <h1 class="itemHeader">Specialization</h1>

                        <div style="max-height: 10.5rem; overflow: hidden; margin-bottom: 2rem;">
                            @if (headers != null && loadout != null)
                            {
                                <div class="reel scroll-in">
                                    <ImageCheckbox ImagePath="@($"images/specializations/{loadout.Specialization}.png")" AltText="@(loadout.Specialization.Replace("_", " "))" IsDisabled="true" />
                                    @{
                                        List<string> specializations = new List<string> (Constants.LSpecializations.Count + Constants.MSpecializations.Count + Constants.HSpecializations.Count);
                                        specializations.AddRange(Constants.LSpecializations);
                                        specializations.AddRange(Constants.MSpecializations);
                                        specializations.AddRange(Constants.HSpecializations);
                                        specializations = Shuffle(specializations);

                                        foreach (var item in specializations)
                                        {
                                            <ImageCheckbox ImagePath="@($"images/specializations/{item}.png")" AltText="@(item.Replace("_", " "))" IsDisabled="true" />
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (rollWeapon)
                {
                    <div class="item">
                        <h1 class="itemHeader">Weapon</h1>

                        <div style="max-height: 10.5rem; overflow: hidden; margin-bottom: 2rem;">
                            @if (headers != null && loadout != null)
                            {
                                <div class="reel scroll-in">
                                    <ImageCheckbox ImagePath="@($"images/weapons/{loadout.Weapon}.png")" AltText="@(loadout.Weapon.Replace("_", " "))" IsDisabled="true" />
                                    @{
                                        List<string> weapons = new List<string> (Constants.LWeapons.Count + Constants.MWeapons.Count + Constants.HWeapons.Count);
                                        weapons.AddRange(Constants.LWeapons);
                                        weapons.AddRange(Constants.MWeapons);
                                        weapons.AddRange(Constants.HWeapons);
                                        weapons = Shuffle(weapons);

                                        foreach (var item in weapons)
                                        {
                                            <ImageCheckbox ImagePath="@($"images/weapons/{item}.png")" AltText="@(item.Replace("_", " "))" IsDisabled="true" />
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (rollGadgets)
            {
                <div class="items">
                    <div class="item">
                        <h1 class="itemHeader">Gadgets</h1>
                        <div class="items">
                            @foreach (string item in loadout.Gadgets) 
                            {
                                <div style="max-height: 10.5rem; overflow: hidden; margin-bottom: 2rem;">
                                    @if (headers != null && loadout != null)
                                    {
                                        <div class="reel scroll-in">
                                            <ImageCheckbox ImagePath="@($"images/gadgets/{item}.png")" AltText="@(item.Replace("_", " "))" IsDisabled="true" />
                                            @{
                                                List<string> gadgets = new List<string> (Constants.LGadgets.Count + Constants.MGadgets.Count + Constants.HGadgets.Count);
                                                gadgets.AddRange(Constants.LGadgets);
                                                gadgets.AddRange(Constants.MGadgets);
                                                gadgets.AddRange(Constants.HGadgets);
                                                gadgets = Shuffle(gadgets);

                                                foreach (var gadget in gadgets)
                                                {
                                                    <ImageCheckbox ImagePath="@($"images/gadgets/{gadget}.png")" AltText="@(gadget.Replace("_", " "))" IsDisabled="true" />
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div style="height:4rem;" />
    }
    else
    {
        @if (loading)
        {
            <Spinner Color="SpinnerColor.Primary" />
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }
    }

    <div style="text-align: center;">
        <div>
            <button class="large-button" @onclick="GenerateRandomLoadout">Generate Random Loadout</button>
            <button class="large-button" @onclick="Share">
                Share
                <i class="bi bi-link" style="color: white;" />
            </button>
        </div>
        @if (copied)
        {
            <p>Copied to clipboard!</p>
        }
    </div>

@* Options *@
    <div class="content-options form-check">
        <h2>
            <i class="bi bi-gear" style="color: white" />
            Options
        </h2>
        <div style="display: flex;">
            <div style="flex: 1;">
                @* <p class="options-header">Items to include:</p>
                <div @onclick="@(() => type = RandomizerType.NEW_ACCOUNT)">
                    <input type="radio" checked="@(type == RandomizerType.NEW_ACCOUNT))"
                        name="type" style=""/>
                    <label>New Account</label>
                </div>
                <div @onclick="@(() => type = RandomizerType.ALL_UNLOCKED)">
                    <input type="radio" checked="@(type == RandomizerType.ALL_UNLOCKED))"
                        name="type" style=""/>
                    <label>All items unlocked</label>
                </div>
                <div @onclick="@(() => type = RandomizerType.ALL_UNLOCKED)">
                    <input type="radio" checked="@(type == RandomizerType.CUSTOM))"
                        name="type" style=""/>
                    <label>Custom</label>
                </div> *@
                <p>You can change the included items <a style="color: white;" href="./randomizer/options">Here!</a></p>
                <p class="options-header">Audio:</p>
                <Switch @bind-value="mute" Label="Mute audio" />
            </div>

            <div style="flex: 1; flex-direction: column;">
                <p class="options-header">Roll Settings:</p>
                <Switch @bind-value="rollSpecialization" Label="Roll specialization" />
                <Switch @bind-value="rollWeapon" Label="Roll weapon" />
                <Switch @bind-value="rollGadgets" Label="Roll gadgets" />
                @* <p class="options-header">Animation:</p>
                <div style="display: flex; gap: 5px;">
                    <p style="margin: 0;">Duration (s):</p>
                    <input class="dark-input" type="number" placeholder="0.00"
                        @bind="duration" min="0"/>
                </div> *@
            </div>
        </div>
    </div>
</div>

@code {
    private Loadout? loadout = null;
    private string errorMessage = "";
    private Dictionary<string, string>? headers = null;
    private Boolean mute = false;
    private RandomizerType type = RandomizerType.CUSTOM;
    private double duration = 2.0;

    private bool rollSpecialization = true;
    private bool rollWeapon = true;
    private bool rollGadgets = true;

    private bool loading = false;
    private bool copied = false;

    protected override async Task OnInitializedAsync()
    {
        mute = await localStorage.GetItemAsync<bool>("randomizer_mute");
        duration = await localStorage.GetItemAsync<double>("randomizer_duration");
        if (duration == 0)
            duration = 2.0;
        string storedType = await localStorage.GetItemAsync<string>("randomizer_type") ?? "CUSTOM";
        Enum.TryParse(storedType, out type);
    }

    private async Task GenerateRandomLoadout()
    {
        // TODO: Remove force of type
        type = RandomizerType.CUSTOM;

        copied = false;
        loading = true;
        loadout = null;
        StateHasChanged();

        // Update some settings
        await localStorage.SetItemAsync("randomizer_mute", mute);
        await localStorage.SetItemAsync("randomizer_type", type);

        Console.WriteLine("gen with: " + type);

        switch (type) {
            case RandomizerType.ALL_UNLOCKED:
                headers = new Dictionary<string, string>();
                break;

            case RandomizerType.NEW_ACCOUNT:
                headers = new Dictionary<string, string> {
                    { "new_account", "true" }
                };
                break;

            default: 
                headers = new Dictionary<string, string> {
                    { "removed_classes", await localStorage.GetItemAsync<string>("classes") ?? "" },
                    { "removed_specializations", await localStorage.GetItemAsync<string>("specializations") ?? "" },
                    { "removed_weapons", await localStorage.GetItemAsync<string>("weapons") ?? "" },
                    { "removed_gadgets", await localStorage.GetItemAsync<string>("gadgets") ?? "" }
                };
                break;
        }

        loadout = await ApiService.Get<Loadout>("items/randomizer", headers);

        if (loadout == null)
            errorMessage = "Unable to generate loadout, please check your settings and try again.";

        loading = false;
        StateHasChanged();
    }

    private List<T> Shuffle<T>(List<T> list) {
        Random rng = new Random();

        for (int i = list.Count; i > 0; i--) {
            int j = rng.Next(i);
            T value = list[j];
            list[j] = list[i - 1];
            list[i - 1] = value;
        }

        return list;
    }

    private void Share()
    {
        if (loadout != null) {
            string baseUri;
            if (_nav.Uri.Contains("?"))
                baseUri = _nav.Uri.Split("?")[0];
            else
                baseUri = _nav.Uri;

            string url = $"{baseUri}?class={loadout.Class}&spec={loadout.Specialization}&weapon={loadout.Weapon}&gadget1={loadout.Gadgets[0]}&gadget2={loadout.Gadgets[1]}&gadget3={loadout.Gadgets[2]}";
            url = url.Replace("randomizer", "loadout");
            jsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
            copied = true;
        }
    }
}
